<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    tools:context=".MainActivity"
    android:paddingHorizontal="10dp"
    android:background="@drawable/button_round_1"
    android:layout_height="match_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:id="@+id/atas"
        android:weightSum="2"
        android:orientation="horizontal"
        android:layout_marginTop="20dp"
        android:padding="10dp"
        android:background="@drawable/button_round_6"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">


        <LinearLayout
            android:layout_weight="1.0"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/namapelanggan"
                android:textStyle="bold"
                android:fontFamily="@font/almendra"
                android:textSize="18sp"
                android:layout_marginLeft="10dp"
                android:textColor="@color/white"
                android:maxLines="2"
                android:text=""
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <TextView
                android:layout_marginTop="4dp"
                android:id="@+id/alamatpelanggan"
                android:textStyle="bold"
                android:fontFamily="@font/almendra"
                android:textSize="13sp"
                android:layout_marginLeft="10dp"
                android:textColor="@color/white"
                android:text=""
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <TextView
                android:layout_marginTop="2dp"
                android:id="@+id/gruppelanggan"
                android:textStyle="bold"
                android:fontFamily="@font/almendra"
                android:textSize="13sp"
                android:layout_marginLeft="10dp"
                android:textColor="@color/white"
                android:text=""
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <com.mikhaellopez.circularimageview.CircularImageView
            android:scaleType="centerInside"
            android:id="@+id/foto"
            android:layout_weight="1.0"
            android:src="@drawable/nasalogo"
            android:layout_width="match_parent"
            android:layout_height="75dp"/>


    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvproduk"
        android:layout_marginBottom="30dp"
        android:layout_marginTop="10dp"
        android:layout_below="@id/atas"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <ProgressBar
        android:visibility="gone"
        android:layout_centerInParent="true"
        android:id="@+id/loading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>



    <LinearLayout
        android:layout_above="@id/layout_bawah"
        android:id="@+id/cartcontainer"
        android:layout_marginHorizontal="0dp"
        android:layout_marginBottom="40dp"
        android:layout_alignParentBottom="true"
        android:layout_width="match_parent"
        android:layout_height="40dp"

        android:background="@drawable/button_round_6">

        <ImageView
            android:layout_width="50dp"
            android:layout_height="20dp"
            android:layout_centerVertical="true"
            android:layout_marginTop="10dp"
            android:src="@drawable/ickeranjang"
            app:tint="@color/black"
            />

        <View
            android:layout_width="0.1dp"
            android:layout_height="match_parent"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp"
            android:background="@color/black" />

        <LinearLayout
            android:orientation="horizontal"

            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:gravity="center"
                android:id="@+id/txtitem"
                android:layout_width="100dp"
                android:layout_height="match_parent"
                android:background="@color/transparent"
                android:text="0 item"
                android:textStyle="bold"
                android:paddingHorizontal="10dp"
                android:textColor="@color/black"
                android:textSize="16sp" />

            <View
                android:layout_width="0.1dp"
                android:layout_height="match_parent"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp"
                android:background="@color/black" />

            <TextView

                android:id="@+id/txtharga"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:background="@color/transparent"
                android:text="Rp. 0"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:textSize="18sp" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_bawah"
        android:weightSum="2"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:layout_alignParentBottom="true">

        <TextView
            android:layout_weight="1"
            android:textColor="@color/colorRipple"
            android:textStyle="bold"
            android:gravity="center"
            android:textSize="16sp"
            android:id="@+id/txtkeluar"
            android:text="MENU"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <TextView
            android:background="@drawable/button_round_9"
            android:layout_weight="1"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:paddingVertical="4dp"
            android:gravity="center"
            android:textSize="13sp"
            android:id="@+id/txttransaksi"
            android:text="TRANSAKSI"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>


    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_barcode"
        android:layout_alignParentBottom="true"
        android:layout_alignParentRight="true"
        android:layout_marginBottom="100dp"
        android:layout_marginRight="10dp"
        android:src="@drawable/ic_barcode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_item"
        android:layout_alignParentBottom="true"
        android:layout_alignParentRight="true"
        android:layout_marginBottom="180dp"
        android:layout_marginRight="10dp"
        android:src="@drawable/ic_barang"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>


    <EditText
        android:id="@+id/hidden_total"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="visible"
        android:inputType="text" />

</RelativeLayout>