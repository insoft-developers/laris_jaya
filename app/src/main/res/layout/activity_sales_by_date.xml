<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@drawable/button_round_1"
    android:padding="10dp"

    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".report.SalesByDateActivity">

    <TextView
        android:textStyle="bold"
        android:textSize="16sp"
        android:layout_marginBottom="30dp"
        android:textAlignment="center"
        android:layout_above="@id/tengah"
        android:text="MASUKKAN TANGGAL PENJUALAN"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <LinearLayout
        android:id="@+id/tengah"
        android:layout_marginHorizontal="20dp"
        android:orientation="vertical"
        android:layout_centerInParent="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <EditText
            android:id="@+id/tanggalawal"
            android:drawablePadding="10dp"
            android:drawableStart="@drawable/ic_cal"
            android:clickable="false"
            android:cursorVisible="false"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:paddingVertical="10dp"
            android:paddingHorizontal="15dp"
            android:background="@drawable/button_round_10"
            android:hint="Masukkan Tanggal Awal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>


        <EditText
            android:id="@+id/tanggalakhir"
            android:drawablePadding="10dp"
            android:drawableStart="@drawable/ic_cal"
            android:layout_marginTop="30dp"
            android:clickable="false"
            android:cursorVisible="false"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:paddingVertical="10dp"
            android:paddingHorizontal="15dp"
            android:background="@drawable/button_round_10"
            android:hint="Masukkan Tanggal Akhir"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <Button
            android:id="@+id/btnsubmit"
            android:textColor="@color/white"
            android:background="@drawable/button_round_2"
            android:layout_marginTop="30dp"
            android:text="SUBMIT"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

    </LinearLayout>

</RelativeLayout>