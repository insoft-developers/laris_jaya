<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never"
    tools:context=".report.SalesByDateActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- KARTU FILTER TANGGAL -->
        <LinearLayout
            android:id="@+id/tengah"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_filter_report"
            android:elevation="5dp"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- IKON -->
            <TextView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/bg_icon_report"
                android:drawablePadding="8dp"
                android:gravity="center"
                android:text="📅"
                android:textSize="25sp"
                tools:ignore="HardcodedText" />

            <!-- JUDUL -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="Laporan Penjualan"
                android:textColor="#111827"
                android:textSize="21sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />

            <!-- DESKRIPSI -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="Pilih periode tanggal untuk melihat data penjualan."
                android:textColor="#6B7280"
                android:textSize="14sp"
                tools:ignore="HardcodedText" />

            <!-- GARIS PEMBATAS -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="18dp"
                android:background="#E5E7EB" />

            <!-- LABEL TANGGAL AWAL -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="7dp"
                android:text="Tanggal awal"
                android:textColor="#374151"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />

            <!-- TANGGAL AWAL -->
            <EditText
                android:id="@+id/tanggalawal"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="@drawable/bg_input_date"
                android:clickable="true"
                android:cursorVisible="false"
                android:drawableStart="@drawable/ic_cal"
                android:drawablePadding="12dp"
                android:ellipsize="end"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:gravity="center_vertical"
                android:hint="Pilih tanggal awal"
                android:inputType="none"
                android:maxLines="1"
                android:paddingHorizontal="16dp"
                android:textColor="#111827"
                android:textColorHint="#9CA3AF"
                android:textSize="15sp"
                tools:ignore="HardcodedText" />

            <!-- PENGHUBUNG TANGGAL -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:gravity="center"
                android:orientation="horizontal">

                <View
                    android:layout_width="20dp"
                    android:layout_height="1dp"
                    android:background="#D1D5DB" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="8dp"
                    android:text="sampai"
                    android:textColor="#9CA3AF"
                    android:textSize="12sp"
                    tools:ignore="HardcodedText" />

                <View
                    android:layout_width="20dp"
                    android:layout_height="1dp"
                    android:background="#D1D5DB" />

            </LinearLayout>

            <!-- LABEL TANGGAL AKHIR -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="7dp"
                android:text="Tanggal akhir"
                android:textColor="#374151"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />

            <!-- TANGGAL AKHIR -->
            <EditText
                android:id="@+id/tanggalakhir"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="@drawable/bg_input_date"
                android:clickable="true"
                android:cursorVisible="false"
                android:drawableStart="@drawable/ic_cal"
                android:drawablePadding="12dp"
                android:ellipsize="end"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:gravity="center_vertical"
                android:hint="Pilih tanggal akhir"
                android:inputType="none"
                android:maxLines="1"
                android:paddingHorizontal="16dp"
                android:textColor="#111827"
                android:textColorHint="#9CA3AF"
                android:textSize="15sp"
                tools:ignore="HardcodedText" />

            <!-- TOMBOL TAMPILKAN -->
            <Button
                android:id="@+id/btnsubmit"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_button_report"
                android:elevation="2dp"
                android:gravity="center"
                android:text="TAMPILKAN LAPORAN"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>