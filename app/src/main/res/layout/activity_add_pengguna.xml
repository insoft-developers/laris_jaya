<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".admin.pengguna.PenggunaAddActivity">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        >

        <LinearLayout
            android:layout_margin="15dp"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:weightSum="2"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <EditText
                    android:layout_weight="0.3"
                    android:id="@+id/et_username"
                    android:layout_marginTop="15dp"
                    android:padding="15dp"
                    android:background="@drawable/button_round_4"
                    android:hint="Username"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>


            </LinearLayout>


            <EditText
                android:id="@+id/et_password"
                android:layout_marginTop="15dp"
                android:padding="15dp"
                android:background="@drawable/button_round_4"
                android:hint="Password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <Spinner
                android:id="@+id/spn_level"
                android:layout_marginTop="15dp"
                android:paddingHorizontal="15dp"
                android:paddingVertical="10dp"
                android:background="@drawable/button_round_4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>


            <EditText
                android:id="@+id/et_name"
                android:layout_marginTop="15dp"
                android:padding="15dp"
                android:background="@drawable/button_round_4"
                android:hint="Nama Lengkap"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>


            <EditText
                android:id="@+id/et_alamat"
                android:layout_marginTop="15dp"
                android:padding="15dp"
                android:background="@drawable/button_round_4"
                android:hint="Alamat (Opsional)"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <EditText
                android:id="@+id/et_telepon"
                android:layout_marginTop="15dp"
                android:padding="15dp"
                android:background="@drawable/button_round_4"
                android:hint="No Whatsapp (Opsional)"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>



            <Button
                android:layout_marginBottom="50dp"
                android:layout_marginTop="40dp"
                android:id="@+id/btn_simpan"
                android:textColor="@color/white"
                android:background="@drawable/button_round_7"
                android:text="Simpan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>


        </LinearLayout>
    </ScrollView>

    <ProgressBar
        android:visibility="gone"
        android:layout_centerInParent="true"
        android:id="@+id/loading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>



</RelativeLayout>