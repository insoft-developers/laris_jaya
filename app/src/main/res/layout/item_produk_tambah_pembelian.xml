<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardProdukPembelian"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="9dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeColor="#E2E8F0"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- GARIS AKSEN -->
        <View
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:background="#2563EB" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="13dp">

            <!-- INFORMASI PRODUK -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:orientation="horizontal">

                <!-- NOMOR URUT -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    app:cardBackgroundColor="#DBEAFE"
                    app:cardCornerRadius="17dp"
                    app:cardElevation="0dp">

                    <TextView
                        android:id="@+id/tvNomorProduk"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="1"
                        android:textColor="#1D4ED8"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:ignore="HardcodedText" />

                </com.google.android.material.card.MaterialCardView>

                <!-- NAMA DAN KODE PRODUK -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvNamaProduk"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:text="Kopi Susu Premium"
                        android:textColor="#0F172A"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:ignore="HardcodedText" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvKodeProduk"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="BRG-00001"
                            android:textColor="#64748B"
                            android:textSize="11sp"
                            tools:ignore="HardcodedText" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="6dp"
                            android:text="•"
                            android:textColor="#CBD5E1"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvSatuanProduk"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PCS"
                            android:textColor="#64748B"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            tools:ignore="HardcodedText" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="11dp"
                android:background="#F1F5F9" />

            <!-- JUMLAH DAN HARGA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Jumlah × Harga Beli"
                        android:textColor="#94A3B8"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/tvJumlahHarga"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="2 × Rp 10.000"
                        android:textColor="#334155"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:ignore="HardcodedText" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Subtotal"
                        android:textColor="#94A3B8"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/tvSubtotalProduk"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Rp 20.000"
                        android:textColor="#334155"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        tools:ignore="HardcodedText" />

                </LinearLayout>

            </LinearLayout>

            <!-- DISKON PRODUK -->
            <LinearLayout
                android:id="@+id/layoutDiskonProduk"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="#FEF2F2"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp"
                android:paddingVertical="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Diskon Produk"
                    android:textColor="#991B1B"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvDiskonProduk"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-Rp 2.000"
                    android:textColor="#DC2626"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:ignore="HardcodedText" />

            </LinearLayout>

            <!-- TOTAL PRODUK -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:background="#EFF6FF"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="11dp"
                android:paddingVertical="9dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Total Produk"
                    android:textColor="#1E40AF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTotalProduk"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rp 18.000"
                    android:textColor="#1D4ED8"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:ignore="HardcodedText" />

            </LinearLayout>

            <!-- TOMBOL AKSI -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="11dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEditProduk"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="43dp"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:text="Edit"
                    android:textAllCaps="false"
                    android:textColor="#2563EB"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:cornerRadius="9dp"
                    app:strokeColor="#93C5FD"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnHapusProduk"
                    android:layout_width="0dp"
                    android:layout_height="43dp"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:text="Hapus"
                    android:textAllCaps="false"
                    android:textColor="#DC2626"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:backgroundTint="#FEF2F2"
                    app:cornerRadius="9dp"
                    app:strokeColor="#FCA5A5"
                    app:strokeWidth="1dp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>